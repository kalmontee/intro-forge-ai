# Copy to .env.local and fill in real values. Never commit .env.local or .env.
# On Netlify, set these under Site configuration > Environment variables
# instead of committing them.

# Required. Google Gemini API key used by POST /api (server-side only).
# Restrict the key to the Generative Language API in Google Cloud.
GEMINI_API_KEY=

# Optional. Comma-separated extra origins allowed to call POST /api, e.g.
# https://www.example.com. Same-origin requests are always allowed, so this
# is only needed if the app is served from more than one origin.
ALLOWED_ORIGINS=
